<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MesaController">
   <children>
      <Label prefHeight="17.0" prefWidth="54.0" text="Mesas" />
      <TableView fx:id="tabelaMesas" prefHeight="434.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="colunaId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colunaStatus" prefWidth="75.0" text="Status" />
        </columns>
      </TableView>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <ComboBox fx:id="statusComboBox" prefWidth="150.0" promptText="Selecione o status" />
            <Button fx:id="botaoCadastrar" mnemonicParsing="false" onAction="#onCadastrarButtonAction" text="Cadastrar" />
            <Button fx:id="botaoAtualizar" mnemonicParsing="false" onAction="#onAtualizarButtonAction" text="Atualizar" />
            <Button fx:id="botaoExcluir" mnemonicParsing="false" onAction="#onExcluirButtonAction" prefHeight="25.0" prefWidth="55.0" text="Excluir" />
         </children>
      </HBox>
   </children>
</VBox>
